# Copy this file to .env and fill in only the keys you need. Never commit .env.
# The code looks for .env in the current folder, the repository and their parent folders,
# and on Colab also in Colab Secrets (key icon on the left).

# Assignment 1, Jev: one of these three is enough (the code uses the first one that is set).
# OpenRouter: Jev is served at /api/v1/systemone
OPENROUTER_API_KEY=
# TypeSafe itself
TYPESAFE_API_KEY=
# Vercel AI Gateway: TypeSafe-compatible route /typesafe/v1/systemone (Jev needs paid gateway credits);
# the same key also reaches other LLMs through the gateway
AI_GATEWAY_API_KEY=

# Assignment 1 LLM baseline and Assignment 2 training-data generation (DeepSeek API)
DEEPSEEK_API_KEY=
